{
  "name": "expression-bridge",
  "displayName": "Expression Bridge",
  "description": "Browse and edit Maya expressions live from VS Code.",
  "version": "1.0.0",
  "publisher": "local",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Jurakii/ExpressionBridge.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onFileSystem:expr-bridge"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "expressionBridge",
          "title": "Expression Bridge",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "expressionBridge": [
        {
          "id": "expressionBridge.tree",
          "name": "Objects"
        },
        {
          "type": "webview",
          "id": "expressionBridge.settings",
          "name": "Settings"
        }
      ]
    },
    "commands": [
      {
        "command": "expressionBridge.connect",
        "title": "Maya: Connect"
      },
      {
        "command": "expressionBridge.refresh",
        "title": "Maya: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "expressionBridge.selectInMaya",
        "title": "Maya: Select Object in Maya",
        "icon": "$(target)"
      },
      {
        "command": "expressionBridge.setUnitConversion",
        "title": "Maya: Set Convert Units"
      },
      {
        "command": "expressionBridge.toggleAlwaysEvaluate",
        "title": "Maya: Toggle Always Evaluate"
      },
      {
        "command": "expressionBridge.installBridge",
        "title": "Maya: Install Bridge into Maya"
      },
      {
        "command": "expressionBridge.uninstallBridge",
        "title": "Maya: Uninstall Bridge from Maya"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "expressionBridge.selectInMaya",
          "when": "false"
        },
        {
          "command": "expressionBridge.setUnitConversion",
          "when": "false"
        },
        {
          "command": "expressionBridge.toggleAlwaysEvaluate",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "expressionBridge.refresh",
          "when": "view == expressionBridge.tree",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "expressionBridge.selectInMaya",
          "when": "viewItem == object",
          "group": "inline"
        },
        {
          "command": "expressionBridge.setUnitConversion",
          "when": "viewItem == expression"
        },
        {
          "command": "expressionBridge.toggleAlwaysEvaluate",
          "when": "viewItem == expression"
        }
      ]
    },
    "configuration": {
      "title": "Expression Bridge",
      "properties": {
        "expressionBridge.followMayaSelection": {
          "type": "boolean",
          "default": true,
          "description": "Highlight the object in the tree when it is selected in Maya."
        }
      }
    },
    "languages": [
      {
        "id": "mel",
        "aliases": [
          "MEL",
          "mel"
        ],
        "extensions": [
          ".mel"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mel",
        "scopeName": "source.mel",
        "path": "./syntaxes/mel.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "lint": "tsc -p . --noEmit",
    "package": "vsce package --no-dependencies --skip-license",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node --require ./out/test/setup.js --test \"out/test/**/*.test.js\"",
    "test:integration": "npm run compile && node ./out/integration/runTest.js",
    "prepackage": "node scripts/bundle-maya.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.1.0",
    "typescript": "^5.4.5",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.1.0"
  }
}
